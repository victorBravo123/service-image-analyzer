@startuml arquitectura-analizador-imagenes
title ARQUITECTURA - ANALIZADOR INTELIGENTE DE CONTENIDO DE IMAGENES

skinparam BackgroundColor #FFFFFF
skinparam ArrowColor #455A64
skinparam RoundCorner 8
skinparam DefaultFontName "Segoe UI"
skinparam DefaultFontSize 12
skinparam ArrowFontSize 11
skinparam Shadowing false

skinparam rectangle {
    BackgroundColor #F8F9FA
    BorderColor #B0BEC5
    FontColor #212121
}

skinparam database {
    BackgroundColor #FFF3E0
    BorderColor #FF9800
    FontColor #212121
}

skinparam cloud {
    BackgroundColor #FBE9E7
    BorderColor #FF5722
    FontColor #212121
}

skinparam actor {
    BackgroundColor #ECEFF1
    BorderColor #607D8B
    FontColor #212121
}

actor "Usuario" as usuario

rectangle "Frontend\n(React + Vite)" as frontend
rectangle "nginx / dev-server\n(proxy /api)" as proxy
rectangle "API Express\nPOST /api/analyze" as api
rectangle "AnalyzeImageUseCase\n(valida que sea imagen)" as use_case
rectangle "Circuit Breaker" as breaker #E0F2F1
rectangle "503\nSERVICE_UNAVAILABLE" as rechazo #FFEBEE
rectangle "ImaggaAnnotator" as imagga

database "Redis\n(estado del circuito)" as redis
cloud "Imagga\n(Externo)" as imagga_ext
cloud "AWS Secrets Manager\n(Externo)" as aws

usuario --> frontend : sube una imagen
frontend --> proxy : multipart/form-data
proxy --> api
api --> use_case
use_case --> breaker : annotate()

breaker --> redis : 1. consulta el estado
breaker --> rechazo : ABIERTO: corta sin\nllamar al proveedor
breaker --> imagga : CERRADO: delega
imagga --> imagga_ext : HTTPS (Basic auth)
breaker --> redis : 2. registra el resultado\nexito: borra el contador\nfallo: +1 y al tercero abre 60s

api ..> aws : credenciales al arrancar

note bottom of redis
  circuit:imagga:failures   contador
  circuit:imagga:open       clave con TTL 60s
  Su sola existencia significa "abierto",
  asi que Redis mide el tiempo por si solo.
end note

note right of breaker
  Solo cuentan los fallos que se
  arreglan esperando: timeout y 5xx si;
  imagen invalida o API key mala no.
end note

@enduml
