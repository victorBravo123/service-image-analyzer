{
  "name": "image-analyzer-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API that analyzes image content through an AI vision provider (hexagonal architecture)",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1120.0",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "ioredis": "6.0.0",
    "multer": "1.4.5-lts.2",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.13",
    "@types/node": "22.20.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
