# Server
PORT=3000

# Image constraints
MAX_IMAGE_MB=5

# AI provider selection: "imagga" (real) or "fake" (deterministic, no key needed)
ANNOTATOR=fake

# Imagga credentials — required only when ANNOTATOR=imagga
# Get free credentials at https://imagga.com/auth/signup
IMAGGA_API_KEY=
IMAGGA_API_SECRET=
IMAGGA_TIMEOUT_MS=10000
