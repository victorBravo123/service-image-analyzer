# Where the process runs: local | dev | qa | staging | prod
# Only APP_ENV=local reads the Imagga credentials from this file.
# Every other value resolves them from AWS Secrets Manager.
APP_ENV=local

# Server
PORT=3000

# Image constraints
MAX_IMAGE_MB=5

# AI provider selection: "imagga" (real) or "fake" (deterministic, no key needed)
ANNOTATOR=fake

# Provider endpoint and client deadline
IMAGGA_BASE_URL=https://api.imagga.com/v2
IMAGGA_TIMEOUT_MS=30000

# --- Credentials: APP_ENV=local only ---
# Get free credentials at https://imagga.com/auth/signup
IMAGGA_API_KEY=
IMAGGA_API_SECRET=

# --- Credentials: every other APP_ENV ---
# Name or ARN of the secret holding {"IMAGGA_API_KEY": "...", "IMAGGA_API_SECRET": "..."}
IMAGGA_SECRET_ID=
# Optional: the AWS SDK resolves it from the runtime when not set
AWS_REGION=
